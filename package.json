{
  "name": "unleash-vscode",
  "displayName": "Unleash for VS Code",
  "description": "See Unleash feature flag configuration in your code, across projects and environments.",
  "version": "0.3.1",
  "publisher": "nunogois",
  "license": "MIT",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": true
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:integration": "node scripts/integration.mjs",
    "vscode:prepublish": "npm run check && npm run build",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "markdown-it": "^14.3.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.99.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "unleash.setup",
        "title": "Unleash: Connect",
        "icon": "$(plug)"
      },
      {
        "command": "unleash.menu",
        "title": "Unleash: Settings and Connection"
      },
      {
        "command": "unleash.refresh",
        "title": "Unleash: Refresh Flags"
      },
      {
        "command": "unleash.environment",
        "title": "Unleash: Select Environment"
      },
      {
        "command": "unleash.demo",
        "title": "Unleash: Try Demo"
      },
      {
        "command": "unleash.disconnect",
        "title": "Unleash: Disconnect and Forget Credentials"
      },
      {
        "command": "unleash.exitDemo",
        "title": "Unleash: Exit Demo / Return to My Instance",
        "icon": "$(debug-stop)"
      },
      {
        "command": "unleash.openWelcome",
        "title": "Unleash: Getting Started",
        "icon": "$(book)"
      },
      {
        "command": "unleash.website",
        "title": "Unleash: Visit Website",
        "icon": {
          "light": "media/unleash-logo-dark.svg",
          "dark": "media/unleash-logo-light.svg"
        }
      },
      {
        "command": "unleash.repository",
        "title": "Unleash: View GitHub Repository",
        "icon": "$(github)"
      },
      {
        "command": "unleash.searchFlags",
        "title": "Unleash: Search Flags",
        "icon": "$(search)"
      },
      {
        "command": "unleash.clearFlagSearch",
        "title": "Unleash: Clear Flag Search",
        "icon": "$(clear-all)"
      },
      {
        "command": "unleash.openFlag",
        "title": "Unleash: Open in Unleash"
      },
      {
        "command": "unleash.quickOpen",
        "title": "Unleash: Quick Open Flag",
        "icon": "$(search)"
      },
      {
        "command": "unleash.copyFlagName",
        "title": "Unleash: Copy Flag Name",
        "icon": "$(copy)"
      },
      {
        "command": "unleash.findFlagUsages",
        "title": "Unleash: Find Flag in Workspace",
        "icon": "$(search)"
      },
      {
        "command": "unleash.inspectFlag",
        "title": "Unleash: View Flag Configuration",
        "icon": "$(preview)"
      },
      {
        "command": "unleash.moreFlags",
        "title": "Unleash: Show More Flags"
      },
      {
        "command": "unleash.copyFlagReference",
        "title": "Unleash: Copy Flag Reference"
      }
    ],
    "configuration": {
      "title": "Unleash",
      "properties": {
        "unleash.refreshIntervalSeconds": {
          "type": "number",
          "default": 15,
          "minimum": 5,
          "maximum": 3600,
          "description": "Refresh interval. Requests never overlap; failures use exponential backoff."
        },
        "unleash.showIndicators": {
          "type": "boolean",
          "default": true,
          "description": "Show a traffic light after recognized flag strings."
        },
        "unleash.maxFileSizeKB": {
          "type": "number",
          "default": 512,
          "minimum": 16,
          "maximum": 4096,
          "description": "Skip larger files to keep the editor responsive."
        }
      }
    },
    "colors": [
      {
        "id": "unleash.on",
        "description": "Unconditional flag",
        "defaults": {
          "dark": "#69D39B",
          "light": "#18723D",
          "highContrast": "#69D39B"
        }
      },
      {
        "id": "unleash.conditional",
        "description": "Conditional or mixed flag",
        "defaults": {
          "dark": "#EBC46A",
          "light": "#855F00",
          "highContrast": "#EBC46A"
        }
      },
      {
        "id": "unleash.off",
        "description": "Disabled flag",
        "defaults": {
          "dark": "#F48787",
          "light": "#B3261E",
          "highContrast": "#F48787"
        }
      },
      {
        "id": "unleash.unknown",
        "description": "Unknown or outdated flag",
        "defaults": {
          "dark": "#CCCCCC",
          "light": "#616161",
          "highContrast": "#FFFFFF"
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "unleash",
          "title": "Unleash",
          "icon": "media/unleash.svg"
        }
      ]
    },
    "views": {
      "unleash": [
        {
          "id": "unleash.home",
          "name": "Unleash",
          "contextualTitle": "Unleash"
        },
        {
          "id": "unleash.flags",
          "name": "Flags",
          "when": "unleash.connected || unleash.demo"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "unleash.home",
        "when": "!unleash.connected && !unleash.demo",
        "contents": "Connect this extension to your Unleash instance.\n[Connect to Unleash](command:unleash.setup)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "unleash.website",
          "when": "view == unleash.home",
          "group": "navigation@0"
        },
        {
          "command": "unleash.repository",
          "when": "view == unleash.home",
          "group": "navigation@2"
        },
        {
          "command": "unleash.exitDemo",
          "when": "view == unleash.home && unleash.demo",
          "group": "navigation@1"
        },
        {
          "command": "unleash.searchFlags",
          "when": "view == unleash.flags",
          "group": "navigation@0"
        },
        {
          "command": "unleash.clearFlagSearch",
          "when": "view == unleash.flags && unleash.flagSearch",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "unleash.openFlag",
          "when": "false"
        },
        {
          "command": "unleash.inspectFlag",
          "when": "false"
        },
        {
          "command": "unleash.moreFlags",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "unleash.copyFlagName",
          "when": "view == unleash.flags && viewItem == unleashFlag",
          "group": "inline"
        },
        {
          "command": "unleash.findFlagUsages",
          "when": "view == unleash.flags && viewItem == unleashFlag",
          "group": "navigation"
        },
        {
          "command": "unleash.openFlag",
          "when": "view == unleash.flags && viewItem == unleashFlag",
          "group": "navigation"
        },
        {
          "command": "unleash.copyFlagReference",
          "when": "view == unleash.flags && viewItem == unleashFlag",
          "group": "navigation"
        }
      ]
    }
  },
  "icon": "media/unleash-icon.png",
  "homepage": "https://getunleash.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/nunogois/unleash-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/nunogois/unleash-vscode/issues"
  }
}
